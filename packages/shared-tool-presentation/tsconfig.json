{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": ["../../extensions/pi-core/node_modules/@earendil-works/pi-coding-agent"],
      "@earendil-works/pi-tui": ["../../extensions/pi-core/node_modules/@earendil-works/pi-tui"],
      "*": ["../../extensions/pi-core/node_modules/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
