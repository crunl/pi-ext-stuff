%%{init: {"theme": "dark", "themeVariables": { "fontSize": "13px" }}}%%
flowchart TD
    LOOP["Agent Loop<br/>tool_call 事件 (bash/write/edit)"] --> GATE1{"门1 · 入口 Abort 门<br/>signal?.aborted ?"}

    GATE1 -- "是" --> ABORT["返回 aborted 结果<br/>❌ 堵住 Esc 竞态窗口"]
    GATE1 -- "否" --> ACT["host.activate(ctx)<br/>激活快照 ActivationFacts"]

    ACT --> YOLO{"privilegeMax<br/>=== yolo ?"}

    YOLO -- "是" --> REVOKE["撤销遗留 grant"] --> BARE["spec.bare() 裸执行<br/>⚠ 不进沙箱 · 无授权消耗"]

    YOLO -- "否 (auto)" --> LEASE{"grant 带 networkHosts ?"}
    LEASE -- "是" --> EXC["EXCLUSIVE 租约<br/>runExclusive 排队"]
    LEASE -- "否" --> SHR["SHARED 租约<br/>runShared 可并发"]

    EXC --> AUTH
    SHR --> AUTH

    subgraph COORD ["SandboxExecutionCoordinator 并发协调"]
        EXC
        SHR
    end

    AUTH["门2 · host.authorize()<br/>GrantLedger verify(epoch+指纹) → consume<br/>single-use burn · 失败即销毁授权"]
    AUTH --> SBREADY{"门3 · 沙箱就绪 ?"}

    SBREADY -- "策略显式关闭" --> BARE2["裸执行（合法豁免）"]
    SBREADY -- "不可用" --> FAIL["fail-closed 抛错<br/>🚫 绝不静默降级裸跑"]
    SBREADY -- "就绪" --> CARVE

    subgraph SANDBOX ["Sandbox 参与点 · 按调用裁剪配置"]
        CARVE["写边界裁剪<br/>withAdditionalWriteRoots(baseConfig, grant.writeRoots)"]
        CARVE --> NET{"grant 带 networkHosts ?"}
        NET -- "是" --> PROXY["合并 allowedDomains<br/>启动 Filtering Proxy<br/>出站仅放行批准域名"]
        NET -- "否" --> EXEC
        PROXY --> EXEC
    end

    EXEC["沙箱内基底执行<br/>bashToolFactory / createSandboxedFileOperations<br/>Git mutation 默认仍走 SRT；显式 escalated action 经审后单次 native Pi"]

    style GATE1 fill:#3d1d20,stroke:#f85149,color:#f85149
    style FAIL fill:#3d1d20,stroke:#f85149,color:#f85149
    style AUTH fill:#12261b,stroke:#3fb950,color:#3fb950
    style COORD fill:#1a1410,stroke:#f0883e,color:#f0883e
    style SANDBOX fill:#1a1410,stroke:#f0883e,color:#f0883e
    style PROXY fill:#241a2e,stroke:#bc8cff,color:#bc8cff
    style BARE fill:#2b2113,stroke:#d29922,color:#d29922
