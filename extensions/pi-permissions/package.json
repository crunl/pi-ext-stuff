{
  "name": "pi-permissions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "core:check": "node scripts/install-core-patch.mjs --check",
    "core:install": "node scripts/install-core-patch.mjs",
    "core:test": "PI_PERMISSIONS_CORE_REGRESSION=1 vitest --run tests/core-execution-gate.test.ts",
    "test": "vitest --run"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "typebox": "1.1.38",
    "vitest": "^4.1.0"
  }
}
