{
  "version": 1,
  "defaultMode": "default",
  "reviewer": {
    "provider": "openai-codex",
    "model": "gpt-5.6",
    "reasoningEffort": "high",
    "timeoutMs": 60000,
    "maxConsecutiveDenials": 3
  },
  "sandbox": {
    "enabled": true,
    "profile": "workspace-write",
    "filesystem": {
      "allowWrite": [
        ".",
        "/tmp"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        ".env",
        ".env.*",
        "*.pem",
        "*.key"
      ],
      "denyWrite": [
        ".env",
        ".env.*",
        "*.pem",
        "*.key"
      ]
    },
    "network": {
      "allowedDomains": [],
      "deniedDomains": [
        "localhost",
        "127.0.0.1",
        "::1",
        "169.254.169.254"
      ]
    }
  },
  "rules": []
}
