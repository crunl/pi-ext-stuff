{
  "name": "pi-core",
  "version": "0.1.0",
  "private": true,
  "description": "An opinionated personal core extension pack for the Pi coding agent.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crunl/pi-ext-stuff.git",
    "directory": "extensions/pi-core"
  },
  "homepage": "https://github.com/crunl/pi-ext-stuff/tree/main/extensions/pi-core#readme",
  "bugs": {
    "url": "https://github.com/crunl/pi-ext-stuff/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "standalone.ts",
    "src"
  ],
  "exports": {
    ".": "./index.ts",
    "./standalone": "./standalone.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest --run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@google/genai": true,
    "protobufjs": true,
    "fsevents": true
  }
}
