{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "../pi-core/node_modules/@earendil-works/pi-coding-agent"
      ],
      "@earendil-works/pi-tui": ["../pi-core/node_modules/@earendil-works/pi-tui"],
      "*": ["../pi-core/node_modules/*"]
    }
  },
  "include": ["index.ts", "standalone.ts", "src/**/*.ts", "tests/**/*.ts"]
}
